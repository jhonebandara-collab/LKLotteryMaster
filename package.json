{
  "name": "lk-lottery-master",
  "version": "1.1.0",
  "private": true,
  "description": "Sri Lanka NLB + DLB lottery result checker with real prize tables, AI ticket scanning and subscriptions",
  "main": "server.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node server.js",
    "scrape": "node scraper.js",
    "sync-draws": "node -e \"console.log(require('./draws-store').syncDraws())\"",
    "test": "node test.js",
    "test:gemini": "node test-gemini.js",
    "health": "node -e \"fetch('http://localhost:'+(process.env.PORT||3000)+'/api/health').then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2))).catch(e=>console.error('Server එක run වෙන්නේ නෑ:',e.message))\""
  },
  "keywords": [
    "lottery",
    "sri-lanka",
    "nlb",
    "dlb",
    "results"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.0.0",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0"
  }
}
